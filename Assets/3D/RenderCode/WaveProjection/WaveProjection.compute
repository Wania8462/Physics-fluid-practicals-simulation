#pragma kernel ClearCounts
#pragma kernel Deposit
#pragma kernel ResolveHeight
#pragma kernel BlurX
#pragma kernel BlurY
#pragma kernel Light

// Sums are whole numbers so they can be added atomically
static const float WeightScale = 1024.0;
static const float HeightScale = 65536.0;

StructuredBuffer<float4> Positions;
RWStructuredBuffer<uint> Counts;  // Two per column: particle weight, then weight times height

// Per column: particle weight, weight times height above the floor. Buffers, as two-channel textures can't be read back here
RWStructuredBuffer<float2> Heights;
RWStructuredBuffer<float2> BlurTemp;
RWTexture2D<float> Blurred;   // Water depth
RWTexture2D<float> LightMap;

uint numParticles;
uint gridWidth;
uint gridHeight;
float2 gridOrigin;
float2 cellSize;
float floorY;
float tankHeight;

float temporalBlend;
int blurRadiusX;
int blurRadiusY;
float2 blurFalloff;
float lensGain;
float minFocus;

void AddWeight(int2 cell, float weight, float heightFraction)
{
    cell = clamp(cell, int2(0, 0), int2(gridWidth, gridHeight) - 1);
    uint index = 2 * (cell.y * gridWidth + cell.x);
    InterlockedAdd(Counts[index], (uint)(weight * WeightScale + 0.5));
    InterlockedAdd(Counts[index + 1], (uint)(weight * heightFraction * HeightScale + 0.5));
}

float BlurredHeightAt(int x, int y)
{
    return Blurred[uint2(clamp(x, 0, (int)gridWidth - 1), clamp(y, 0, (int)gridHeight - 1))];
}

[numthreads(64,1,1)]
void ClearCounts (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= 2 * gridWidth * gridHeight) return;

    Counts[id.x] = 0;
}

// Shares each particle between the four nearest columns, so sums change smoothly as it moves
[numthreads(64,1,1)]
void Deposit (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float3 position = Positions[id.x].xyz;
    float heightFraction = saturate((position.y - floorY) / tankHeight);

    float2 grid = (position.xz - gridOrigin) / cellSize - 0.5;
    int2 lower = (int2)floor(grid);
    float2 t = grid - lower;

    AddWeight(lower, (1 - t.x) * (1 - t.y), heightFraction);
    AddWeight(lower + int2(1, 0), t.x * (1 - t.y), heightFraction);
    AddWeight(lower + int2(0, 1), (1 - t.x) * t.y, heightFraction);
    AddWeight(lower + int2(1, 1), t.x * t.y, heightFraction);
}

// Column sums averaged over time to remove particle jitter
[numthreads(8,8,1)]
void ResolveHeight (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= gridWidth || id.y >= gridHeight) return;

    uint cell = id.y * gridWidth + id.x;
    float2 sums = float2(Counts[2 * cell] / WeightScale, Counts[2 * cell + 1] / HeightScale * tankHeight);

    // The buffer holds nothing valid until it's first written
    Heights[cell] = temporalBlend >= 1 ? sums : lerp(Heights[cell], sums, temporalBlend);
}

[numthreads(8,8,1)]
void BlurX (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= gridWidth || id.y >= gridHeight) return;

    float2 sum = 0;
    for (int x = -blurRadiusX; x <= blurRadiusX; x++)
        sum += Heights[id.y * gridWidth + clamp((int)id.x + x, 0, (int)gridWidth - 1)] * exp(x * x * blurFalloff.x);

    BlurTemp[id.y * gridWidth + id.x] = sum;
}

// Depth is twice the particles' average height, so sparse columns by walls and bodies don't read as shallow
[numthreads(8,8,1)]
void BlurY (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= gridWidth || id.y >= gridHeight) return;

    float2 sum = 0;
    for (int y = -blurRadiusY; y <= blurRadiusY; y++)
        sum += BlurTemp[clamp((int)id.y + y, 0, (int)gridHeight - 1) * gridWidth + id.x] * exp(y * y * blurFalloff.y);

    Blurred[id.xy] = sum.x > 1e-4 ? 2 * sum.y / sum.x : 0;
}

// How much light reaches the plane under each column. Crests curve down, so they focus light and read above 1
[numthreads(8,8,1)]
void Light (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= gridWidth || id.y >= gridHeight) return;

    int x = id.x;
    int y = id.y;
    float centre = BlurredHeightAt(x, y);
    float curveX = (BlurredHeightAt(x - 1, y) + BlurredHeightAt(x + 1, y) - 2 * centre) / (cellSize.x * cellSize.x);
    float curveY = (BlurredHeightAt(x, y - 1) + BlurredHeightAt(x, y + 1) - 2 * centre) / (cellSize.y * cellSize.y);

    LightMap[id.xy] = 1 / max(minFocus, 1 + lensGain * (curveX + curveY));
}
