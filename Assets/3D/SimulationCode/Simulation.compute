#pragma kernel ExternalForces
#pragma kernel ClearForceBuffers
#pragma kernel CalculateLambdas
#pragma kernel CalculateDeltaPositions
#pragma kernel ApplyDeltaPositions
#pragma kernel ApplyForceBuffersToVelocities
#pragma kernel ApplyViscosity
#pragma kernel ResolveBoundaries
#pragma kernel AdvancePredictedPositions
#pragma kernel AttractToMouse
#pragma kernel CalculateVelocity
#pragma kernel ClearGrid
#pragma kernel CountParticles
#pragma kernel ScanStep
#pragma kernel ResetCursor
#pragma kernel Scatter
#pragma kernel ClearBoundaryGrid
#pragma kernel CountBoundaryParticles
#pragma kernel BoundaryScanStep
#pragma kernel ResetBoundaryCursor
#pragma kernel ScatterBoundary
#pragma kernel CalculateBoundaryVolumes
#pragma kernel ClearBoundaryForceBuffers
#pragma kernel PlaceBoundaryParticles
#pragma kernel BodyAdvancePredictedStates
#pragma kernel SumCouplingForces
#pragma kernel ApplyCouplingForces
#pragma kernel AttractBodiesToMouse
#pragma kernel SumContacts
#pragma kernel ApplyContacts
#pragma kernel BodyCalculateVelocity
#pragma kernel SmoothBodyForces
#pragma kernel ResolveBodyCollisions

#include "FluidMath3D.hlsl"
#include "RigidBodyMath3D.hlsl"

static const float4 ZeroImpulse = float4(0, 0, 0, 0);
static const int FloatScale = 1000000;


RWStructuredBuffer<float4> Positions;
RWStructuredBuffer<float4> PrevPositions;
RWStructuredBuffer<int> ForceBuffersX;
RWStructuredBuffer<int> ForceBuffersY;
RWStructuredBuffer<int> ForceBuffersZ;
RWStructuredBuffer<float4> Velocities;

// PBF solver state. Densities are number densities, 1 at rest. Lambdas are the constraint multipliers, which act as
// pressure, and DeltaPositions each particle's correction for the current iteration
RWStructuredBuffer<float> Densities;
RWStructuredBuffer<float> Lambdas;
RWStructuredBuffer<float4> DeltaPositions;

// Compact grid: particle indices grouped by cell in one contiguous buffer.
// Cell c occupies SortedIndices[CellStart[c] .. CellStart[c + 1]).
RWStructuredBuffer<uint> CellStart;
RWStructuredBuffer<uint> ScanTemp;
RWStructuredBuffer<uint> CellCursor;
RWStructuredBuffer<uint> SortedIndices;

// Boundary particles: surface samples of every rigid body, stored body after body
RWStructuredBuffer<float4> BoundaryPositions;
RWStructuredBuffer<float4> BoundaryVelocities;
RWStructuredBuffer<float4> BoundaryRestPositions;
RWStructuredBuffer<float> BoundaryVolumes;
RWStructuredBuffer<int> BoundaryForceBuffersX;
RWStructuredBuffer<int> BoundaryForceBuffersY;
RWStructuredBuffer<int> BoundaryForceBuffersZ;
RWStructuredBuffer<uint> BoundaryBodyIndices;

// Compact grid of the boundary particles, laid out like CellStart and SortedIndices
RWStructuredBuffer<uint> BoundaryCellStart;
RWStructuredBuffer<uint> BoundarySortedIndices;

// One entry per rigid body
RWStructuredBuffer<RigidBodyProperties> BodyProperties;
RWStructuredBuffer<RigidBodyState> BodyStates;

// Scratch slots for the per-body reductions, BodyReductionThreads slots per body
RWStructuredBuffer<float4> BodyCouplingSums;
RWStructuredBuffer<float4> BodyContactSums;

// The last step's forces on each body, BodyForceCount per body, in sim mass times sim length per second squared.
// The physics only writes it, for SmoothBodyForces to ease into SmoothedBodyForces
RWStructuredBuffer<float4> BodyForces;
// BodyForces eased over a few steps, which is what the Visualiser draws
RWStructuredBuffer<float4> SmoothedBodyForces;

// The last step's push of each scale on each body, MaxScales per body, in the same units as BodyForces. The CPU adds
// them up per scale for its reading
RWStructuredBuffer<float4> BodyScaleForces;

// Read-only views bound to the same GPU buffers as the declarations above. Kernels that only read a
// buffer go through these, because a compute shader gets 8 read-write slots but 128 read-only ones.
// A kernel must use either the read-write or the read-only name of a buffer, never both
StructuredBuffer<float4> PositionsRO;
StructuredBuffer<float4> VelocitiesRO;
StructuredBuffer<float> LambdasRO;
StructuredBuffer<uint> CellStartRO;
StructuredBuffer<uint> SortedIndicesRO;
StructuredBuffer<float4> BoundaryPositionsRO;
StructuredBuffer<float4> BoundaryVelocitiesRO;
StructuredBuffer<float> BoundaryVolumesRO;
StructuredBuffer<uint> BoundaryCellStartRO;
StructuredBuffer<uint> BoundarySortedIndicesRO;

const uint numParticles;
const float particleRadius;
const float interactionRadius;
const float interactionRadiusSq;

const float gravity;
const float mouseAttractiveness;
const float mouseRadius;

// PBF (Macklin & Müller 2013) in number density form: every particle stands for particleVolume of fluid, so the
// constraint doesn't depend on the fluid's density, only particleMass does
const float particleVolume;
const float particleMass;
const float restSpacing;
const float relaxation;
const float artificialPressure;
const float poly6Factor;
const float spikyGradFactor;

const float highViscosity;
const float lowViscosity;

const float collisionDamp;
const float4 realHalfBoundSize;

const float4 mousePosition;
const float dt;

const uint numCells;
const float4 offset;
const float cellLength;
const uint columns;
const uint rows;
const uint layers;

// Hillis-Steele scan step: stride doubles each pass, flip alternates the
// ping-pong direction. Both are uniform, so the branch on flip never diverges.
const uint scanStride;
const uint scanFlip;

const uint numBoundaryParticles;
const uint numBodies;
const float boundaryFriction;
const float bodyFriction;
// Share of the last step's forces blended into SmoothedBodyForces per step
const float forceSmoothing;

void SetForceBuffer(uint index, float4 value)
{
    ForceBuffersX[index] = (int)(value.x * FloatScale);
    ForceBuffersY[index] = (int)(value.y * FloatScale);
    ForceBuffersZ[index] = (int)(value.z * FloatScale);
}

void AtomicAddForceBuffer(uint index, float4 value)
{
    InterlockedAdd(ForceBuffersX[index], (int)(value.x * FloatScale));
    InterlockedAdd(ForceBuffersY[index], (int)(value.y * FloatScale));
    InterlockedAdd(ForceBuffersZ[index], (int)(value.z * FloatScale));
}

float4 ReadForceBuffer(uint index)
{
    return float4((float)ForceBuffersX[index] / FloatScale,
    (float)ForceBuffersY[index] / FloatScale,
    (float)ForceBuffersZ[index] / FloatScale,
    0);
}

// Defined in the spatial partitioning section below
uint3 GetCellPosition(float4 position);
uint GetCellIndex(uint3 cellPosition);

// Fluid-body coupling, defined in RigidBodyKernels3D.hlsl
void AddBoundaryDensity(float4 position, uint3 cellPosition, inout float density, inout float4 gradient);
void AddBoundaryCorrection(float4 position, uint3 cellPosition, float lambda, inout float4 delta);
void ApplyBoundaryFriction(uint index, float4 position, float4 velocity, uint3 cellPosition);

[numthreads(64,1,1)]
void ExternalForces (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    Velocities[id.x].y += dt * gravity;
}

[numthreads(64,1,1)]
void ClearForceBuffers (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    SetForceBuffer(id.x, ZeroImpulse);
}

// The walls count as fluid at rest beyond them, so a particle next to one isn't missing half its neighbours.
// Distances to the walls over the interaction radius, 1 (no effect) past it
float3 WallDistances(float4 position)
{
    return saturate((realHalfBoundSize.xyz - abs(position.xyz)) / interactionRadius);
}

// The density constraint C = max(density - 1, 0) and its multiplier lambda = -C / (sum of |grad C|² + relaxation).
// Clamped at 0, so the free surface never pulls. Boundary particles and walls don't move in the solve, so only the
// particle itself and its fluid neighbours count in the sum
[numthreads(64,1,1)]
void CalculateLambdas (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float4 position = PositionsRO[id.x];
    uint3 cellPosition = GetCellPosition(position);

    float density = 0;
    float4 gradient = 0;            // Of C with respect to this particle
    float neighbourGradients = 0;   // Sum of |grad C|² with respect to each neighbour

    for (uint i = 0; i < 27; i++)
    {
        int3 cellOffset = int3(i % 3, (i / 3) % 3, i / 9) - 1;
        uint3 neighbourPos = cellPosition + cellOffset; // negatives wrap and fail the bounds check
        if (neighbourPos.x >= columns || neighbourPos.y >= rows || neighbourPos.z >= layers) continue;
        uint cell = GetCellIndex(neighbourPos);

        for (uint j = CellStartRO[cell]; j < CellStartRO[cell + 1]; j++)
        {
            float4 neighbourPosition = PositionsRO[SortedIndicesRO[j]];
            float magSq = DistanceSq(position, neighbourPosition);
            if (magSq >= interactionRadiusSq) continue;

            // The particle itself counts towards its density
            density += particleVolume * Poly6(magSq, interactionRadiusSq, poly6Factor);
            if (magSq == 0) continue;

            float mag = sqrt(magSq);
            float4 neighbourGradient = particleVolume *
                SpikyGradient(mag, interactionRadius, spikyGradFactor, UnitVector(position, neighbourPosition, mag));

            gradient += neighbourGradient;
            neighbourGradients += dot(neighbourGradient, neighbourGradient);
        }
    }

    // numBodies is the same for every thread, so this branch costs no divergence
    if (numBodies > 0)
        AddBoundaryDensity(position, cellPosition, density, gradient);

    float3 wallDistances = WallDistances(position);
    density += dot(WallDensity(wallDistances), float3(1, 1, 1));
    gradient.xyz += sign(position.xyz) * WallDensityGradient(wallDistances, interactionRadius);

    float constraint = max(density - 1.0, 0.0);
    Densities[id.x] = density;
    Lambdas[id.x] = -constraint / (dot(gradient, gradient) + neighbourGradients + relaxation);
}

// Each particle's correction from its own and its neighbours' lambdas, gathered so no atomics are needed. The
// artificial pressure term s_corr keeps particles from clumping where the clamped constraint has no effect
[numthreads(64,1,1)]
void CalculateDeltaPositions (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float4 position = PositionsRO[id.x];
    float lambda = LambdasRO[id.x];
    uint3 cellPosition = GetCellPosition(position);

    // s_corr = -k (W(r) / W(0.2 h))^4, as in the paper
    float sCorrKernel = Poly6(0.04 * interactionRadiusSq, interactionRadiusSq, poly6Factor);
    float4 delta = 0;

    for (uint i = 0; i < 27; i++)
    {
        int3 cellOffset = int3(i % 3, (i / 3) % 3, i / 9) - 1;
        uint3 neighbourPos = cellPosition + cellOffset;
        if (neighbourPos.x >= columns || neighbourPos.y >= rows || neighbourPos.z >= layers) continue;
        uint cell = GetCellIndex(neighbourPos);

        for (uint j = CellStartRO[cell]; j < CellStartRO[cell + 1]; j++)
        {
            uint neighbour = SortedIndicesRO[j];
            float4 neighbourPosition = PositionsRO[neighbour];
            float magSq = DistanceSq(position, neighbourPosition);
            if (magSq == 0 || magSq >= interactionRadiusSq) continue;

            float mag = sqrt(magSq);
            float ratio = Poly6(magSq, interactionRadiusSq, poly6Factor) / sCorrKernel;
            float sCorr = -artificialPressure * ratio * ratio * ratio * ratio;

            delta += particleVolume * (lambda + LambdasRO[neighbour] + sCorr) *
                SpikyGradient(mag, interactionRadius, spikyGradFactor, UnitVector(position, neighbourPosition, mag));
        }
    }

    if (numBodies > 0)
        AddBoundaryCorrection(position, cellPosition, lambda, delta);

    delta.xyz += lambda * sign(position.xyz) * WallDensityGradient(WallDistances(position), interactionRadius);

    DeltaPositions[id.x] = delta;
}

[numthreads(64,1,1)]
void ApplyDeltaPositions (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    Positions[id.x] += DeltaPositions[id.x];
}

[numthreads(64,1,1)]
void ApplyForceBuffersToVelocities (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    Velocities[id.x] += ReadForceBuffer(id.x);
}

[numthreads(64,1,1)]
void ApplyViscosity (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float4 position = PositionsRO[id.x];
    float4 velocity = VelocitiesRO[id.x];
    uint3 cellPosition = GetCellPosition(position);

    for (uint i = 0; i < 27; i++)
    {
        int3 cellOffset = int3(i % 3, (i / 3) % 3, i / 9) - 1;
        uint3 neighbourPos = cellPosition + cellOffset; // negatives wrap and fail the bounds check
        if (neighbourPos.x >= columns || neighbourPos.y >= rows || neighbourPos.z >= layers) continue;
        uint cell = GetCellIndex(neighbourPos);

        for (uint j = CellStartRO[cell]; j < CellStartRO[cell + 1]; j++)
        {
            uint neighbour = SortedIndicesRO[j];
            float mag = Distance(position, PositionsRO[neighbour]);
            if (mag > interactionRadius || mag == 0) continue;

            float q = mag / interactionRadius;
            float4 r = UnitVector(position, PositionsRO[neighbour], mag);
            float inwardVelocity = dot(velocity - VelocitiesRO[neighbour], r);
            if(inwardVelocity <= 0) continue;

            float4 impulse = ViscosityImpulse(dt, highViscosity, lowViscosity, q, inwardVelocity, r) * 0.5f;
            AtomicAddForceBuffer(id.x, -impulse);
            AtomicAddForceBuffer(neighbour, impulse);
        }
    }

    // numBodies is the same for every thread, so this branch costs no divergence
    if (numBodies > 0)
        ApplyBoundaryFriction(id.x, position, velocity, cellPosition);
}

[numthreads(64,1,1)]
void ResolveBoundaries (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    if (abs(Positions[id.x].x) >= realHalfBoundSize.x)
    {
        int signOfPos = sign(Positions[id.x].x);
        Positions[id.x].x = realHalfBoundSize.x * signOfPos;
        Positions[id.x].x -= signOfPos * collisionDamp;
    }

    if (abs(Positions[id.x].y) >= realHalfBoundSize.y)
    {
        int signOfPos = sign(Positions[id.x].y);
        Positions[id.x].y = realHalfBoundSize.y * signOfPos;
        Positions[id.x].y -= signOfPos * collisionDamp;
    }

    if (abs(Positions[id.x].z) >= realHalfBoundSize.z)
    {
        int signOfPos = sign(Positions[id.x].z);
        Positions[id.x].z = realHalfBoundSize.z * signOfPos;
        Positions[id.x].z -= signOfPos * collisionDamp;
    }
}

[numthreads(64,1,1)]
void AdvancePredictedPositions (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    PrevPositions[id.x] = Positions[id.x];
    Positions[id.x] += dt * Velocities[id.x];
}

[numthreads(64,1,1)]
void AttractToMouse (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float mag = Distance(Positions[id.x], mousePosition);
    if (mag > mouseRadius) return;

    float4 r = UnitVector(Positions[id.x], mousePosition, mag);
    Positions[id.x] += dt * mouseAttractiveness * r;
}

[numthreads(64,1,1)]
void CalculateVelocity (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    Velocities[id.x] = (Positions[id.x] - PrevPositions[id.x]) / dt;
}

// ---------- Spatial partitioning (3D: cubic cells, 27 adjacent cells) ----------

uint3 GetCellPosition(float4 position)
{
    float3 scaled = (position.xyz - offset.xyz) / cellLength;
    return uint3((uint)clamp(scaled.x, 0, columns - 1),
    (uint)clamp(scaled.y, 0, rows - 1),
    (uint)clamp(scaled.z, 0, layers - 1));
}

uint GetCellIndex(uint3 cellPosition)
{
    return cellPosition.x + cellPosition.y * columns + cellPosition.z * columns * rows;
}

// The grid is built by counting sort: count per cell, prefix sum the counts into
// start offsets, then scatter particle indices into their cell's slice. There is
// no per-cell capacity, so no particle is ever dropped.

// CellStart holds the counts first, shifted up one slot so the inclusive scan
// below turns them straight into exclusive start offsets.
[numthreads(64,1,1)]
void ClearGrid (uint3 id : SV_DispatchThreadID)
{
    if (id.x > numCells) return;

    CellStart[id.x] = 0;
}

[numthreads(64,1,1)]
void CountParticles (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    uint cellIndex = GetCellIndex(GetCellPosition(Positions[id.x]));
    InterlockedAdd(CellStart[cellIndex + 1], 1);
}

[numthreads(64,1,1)]
void ScanStep (uint3 id : SV_DispatchThreadID)
{
    if (id.x > numCells) return;

    uint previous = max((int)id.x - (int)scanStride, 0);
    uint mask = id.x >= scanStride; // 0 for the first stride entries, which carry nothing

    // scanFlip is uniform across the dispatch, so this costs no divergence
    if (scanFlip == 0)
        ScanTemp[id.x] = CellStart[id.x] + CellStart[previous] * mask;
    else
        CellStart[id.x] = ScanTemp[id.x] + ScanTemp[previous] * mask;
}

[numthreads(64,1,1)]
void ResetCursor (uint3 id : SV_DispatchThreadID)
{
    if (id.x > numCells) return;

    CellCursor[id.x] = CellStart[id.x];
}

[numthreads(64,1,1)]
void Scatter (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    uint cellIndex = GetCellIndex(GetCellPosition(Positions[id.x]));
    uint destination;
    InterlockedAdd(CellCursor[cellIndex], 1, destination);

    SortedIndices[destination] = id.x;
}

// ---------- Rigid bodies ----------
// The kernels live in their own file to keep this one readable. Their pragmas and declarations have to stay
// in this file, the only one ComputeHelper reflection reads
#include "RigidBodyKernels3D.hlsl"
